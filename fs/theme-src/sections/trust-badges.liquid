{%- comment -%}
  Trust badges / USP row: up to 6 icons with a short benefit line each.
  Icons come from Dawn's accordion icon set (snippets/icon-accordion.liquid).
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="trust-badges-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="trust-badges__heading inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    <ul
      class="trust-badges trust-badges--{{ section.settings.layout }} list-unstyled"
      role="list"
      style="--trust-badges-count: {{ section.blocks.size | at_least: 1 }};"
    >
      {%- for block in section.blocks -%}
        <li
          class="trust-badges__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.icon != 'none' -%}
            <span class="trust-badges__icon" aria-hidden="true">
              {%- render 'icon-accordion', icon: block.settings.icon -%}
            </span>
          {%- endif -%}
          <div class="trust-badges__content">
            {%- if block.settings.title != blank -%}
              <p class="trust-badges__title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="trust-badges__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

