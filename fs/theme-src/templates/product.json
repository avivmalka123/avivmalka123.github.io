{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "trust": {
          "type": "text",
          "settings": {
            "text": "משלוח מהיר לכל הארץ · תשלום מאובטח · החזרה קלה",
            "text_style": "subtitle"
          }
        },
        "description": {
          "type": "description"
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "משלוחים",
            "icon": "truck",
            "content": "<p>אנחנו שולחים לכל הארץ. ההזמנה יוצאת לטיפול מיד לאחר התשלום, וזמן המשלוח המשוער מוצג בעמוד התשלום. כשהחבילה יוצאת נשלח לכם מספר מעקב.</p>"
          }
        },
        "returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "החזרות והחלפות",
            "icon": "return",
            "content": "<p>לא התאים? אפשר להחזיר או להחליף בתוך 14 יום מקבלת ההזמנה, בהתאם למדיניות ההחזרות ולחוק הגנת הצרכן. פשוט פנו אלינו ונטפל בזה במהירות.</p>"
          }
        },
        "payment": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "תשלום מאובטח",
            "icon": "lock",
            "content": "<p>התשלום מתבצע בעמוד תשלום מאובטח ומוצפן (SSL). פרטי האשראי לא נשמרים אצלנו.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "שיתוף"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust",
        "description",
        "shipping",
        "returns",
        "payment",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "right",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 28,
        "padding_bottom": 24
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "אולי יעניין אותך גם",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
